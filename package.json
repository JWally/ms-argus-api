{
  "name": "ms-argus-api",
  "version": "0.1.0",
  "description": "Argus Fraud Detection API - Fingerprint ingestion and analysis pipeline",
  "bin": {
    "ms-argus-api": "bin/ms-argus-api.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "lint:fix": "npx eslint --fix .",
    "lint:test": "npx eslint --fix-dry-run .",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^22.7.9",
    "@vitest/coverage-v8": "^3.0.2",
    "aws-cdk": "2.1007.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-promise": "^6.6.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.13.1",
    "@aws-lambda-powertools/metrics": "^2.13.1",
    "@aws-lambda-powertools/tracer": "^2.13.1",
    "@aws-sdk/client-secrets-manager": "^3.726.1",
    "@aws-sdk/client-sns": "^3.726.1",
    "@middy/core": "^6.0.0",
    "@middy/http-cors": "^6.0.0",
    "@middy/http-error-handler": "^6.0.0",
    "@middy/http-header-normalizer": "^6.0.0",
    "@middy/http-json-body-parser": "^6.0.0",
    "@middy/validator": "^6.0.0",
    "@middy/warmup": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "aws-cdk-lib": "2.190.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.4.2",
    "http-errors": "^2.0.0",
    "lru-cache": "^11.0.2"
  }
}
