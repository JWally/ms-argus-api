{
  "name": "ms-argus-api",
  "version": "0.1.0",
  "description": "Argus Fraud Detection API - Fingerprint ingestion and analysis pipeline",
  "bin": {
    "ms-argus-api": "bin/ms-argus-api.js"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "lint:fix": "npx eslint --fix .",
    "lint:test": "npx eslint --fix-dry-run .",
    "deps": "depcruise --config .dependency-cruiser.cjs src lib",
    "dead-code": "knip",
    "duplication": "jscpd src lib",
    "mutate": "stryker run",
    "quality": "npm run lint:test && npm run deps && npm run dead-code && npm run duplication",
    "docs": "typedoc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.7.9",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.2",
    "aws-cdk": "2.1007.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-sonarjs": "^0.25.1",
    "eslint-plugin-unicorn": "^48.0.1",
    "jscpd": "^4.0.7",
    "knip": "^5.82.1",
    "lefthook": "^2.0.13",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.16",
    "typescript": "~5.6.3",
    "vitest": "^3.0.2"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.13.1",
    "@aws-lambda-powertools/metrics": "^2.13.1",
    "@aws-sdk/client-dynamodb": "^3.726.1",
    "@aws-sdk/client-firehose": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/client-secrets-manager": "^3.726.1",
    "@aws-sdk/client-ssm": "^3.1017.0",
    "@aws-sdk/util-dynamodb": "^3.726.1",
    "@middy/core": "^6.0.0",
    "@middy/http-header-normalizer": "^6.0.0",
    "@middy/warmup": "^6.0.0",
    "aws-cdk-lib": "2.190.0",
    "constructs": "^10.4.2",
    "lru-cache": "^11.0.2"
  }
}
