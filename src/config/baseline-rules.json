{
  "version": 1,
  "rules": [
    {
      "id": "excessive_lies",
      "description": "Skip if excessive API tampering (>50 lies)",
      "condition": { "field": "lie_count", "operator": ">", "value": 50 }
    },
    {
      "id": "worker_ua_mismatch",
      "description": "Skip if worker UA disagrees with navigator UA",
      "condition": {
        "field": "worker_ua_mismatch",
        "operator": "==",
        "value": true
      }
    },
    {
      "id": "headless_with_stealth",
      "description": "Skip headless browsers with stealth plugins",
      "condition": {
        "all": [
          { "field": "is_headless", "operator": "==", "value": true },
          { "field": "lie_count", "operator": ">", "value": 10 }
        ]
      }
    }
  ],
  "environments": {
    "dev": { "disabled_rules": [] },
    "prod": { "disabled_rules": [] }
  }
}
