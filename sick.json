{
  "scan": ".",

  "exclude": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "cdk.out",
    "coverage",
    "cdk.context.json",
    "ideas"
  ],

  "excludeFiles": ["package-lock.json"],

  "extensions": [".ts", ".json", ".md", ".go"],

  "showExcluded": true,
  "showSkipped": true,

  "outputFile": "output.sick"
}
