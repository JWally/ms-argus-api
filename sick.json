{
  "scan": ".",
  "exclude": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "cdk.out",
    "coverage",
    "test",
    "ideas"
  ],
  "excludeFiles": ["package-lock.json", "*.test.ts"],
  "extensions": [".ts", ".tsx", ".json", ".md", ".js", ".mjs", ".css", ".html"],
  "showExcluded": true,
  "showSkipped": true,
  "outputFile": "output.sick"
}
