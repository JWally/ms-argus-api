const { CloudFormationClient, DescribeStacksCommand } = require('@aws-sdk/client-cloudformation');
const { ElastiCacheClient, DescribeReplicationGroupsCommand } = require('@aws-sdk/client-elasticache');

const cfnClient = new CloudFormationClient({ region: 'us-east-1' });
const ecClient = new ElastiCacheClient({ region: 'us-east-1' });

async function waitForBoth() {
  let stackDone = false;
  let redisDone = false;
  
  while (stackDone === false || redisDone === false) {
    const now = new Date().toLocaleTimeString();
    
    if (stackDone === false) {
      try {
        const stacks = await cfnClient.send(new DescribeStacksCommand({ StackName: 'ms-argus-api-dev-jw' }));
        const status = stacks.Stacks[0].StackStatus;
        console.log(now, '- Stack:', status);
        if (status.includes('IN_PROGRESS') === false) {
          stackDone = true;
          console.log('Stack rollback complete:', status);
        }
      } catch (e) {
        if (e.message.includes('does not exist')) {
          console.log(now, '- Stack: DELETED');
          stackDone = true;
        }
      }
    }
    
    if (redisDone === false) {
      try {
        const result = await ecClient.send(new DescribeReplicationGroupsCommand({
          ReplicationGroupId: 'ms-argus-api-dev-jw-redis'
        }));
        const status = result.ReplicationGroups[0].Status;
        console.log(now, '- Redis:', status);
        if (status !== 'deleting') {
          redisDone = true;
        }
      } catch (e) {
        if (e.name === 'ReplicationGroupNotFoundFault') {
          console.log(now, '- Redis: DELETED');
          redisDone = true;
        }
      }
    }
    
    if (stackDone === false || redisDone === false) {
      await new Promise(r => setTimeout(r, 30000));
    }
  }
  console.log('\nBoth stack rollback and Redis deletion complete!');
}
waitForBoth();

